<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/BetterStickyNotes.ico</ApplicationIcon>
    <AssemblyName>BetterStickyNotes</AssemblyName>
    <Version>0.10.1</Version>
  </PropertyGroup>
  <ItemGroup><PackageReference Include="Markdig" Version="0.41.3" /></ItemGroup>
  <ItemGroup><PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" /></ItemGroup>
  <ItemGroup>
    <Resource Include="Assets/BetterStickyNotes.ico"/>
    <Using Remove="System.Drawing"/><Using Remove="System.Windows.Forms"/>
    <Compile Remove="tests/**/*.cs"/>
  </ItemGroup>
</Project>
