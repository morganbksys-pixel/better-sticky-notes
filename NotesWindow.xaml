<Window x:Class="BetterStickyNotes.NotesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Mes notes — Better Sticky Notes" ShowInTaskbar="True" Icon="Assets/BetterStickyNotes.ico" Width="900" Height="580" MinWidth="740" MinHeight="400" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13" Background="#FAFAFA">
    <Border Background="#FAFAFA" Padding="24"><Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Mes notes" FontSize="26" FontWeight="SemiBold"/>
            <TabControl x:Name="NoteTabs" SelectionChanged="TabChanged" Margin="0,12,0,0" SelectedIndex="0" Background="Transparent" BorderThickness="0">
                <TabItem Header="Mes notes" Padding="18,8"/><TabItem Header="Corbeille" Padding="18,8"/>
            </TabControl>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,16,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Padding="10,8" TextChanged="SearchChanged" ToolTip="Rechercher dans les titres et le contenu" AutomationProperties.Name="Rechercher dans les notes"/>
            <TextBlock Text="Rechercher un titre ou du contenu…" IsHitTestVisible="False" Margin="12,8" Foreground="#777777"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            <Button Grid.Column="1" Content="Nouvelle note" Margin="12,0,0,0" Click="NewClick" Background="#E1EAF7"/>
        </Grid>
        <Grid Grid.Row="2" Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><Button Content="Tout sélectionner" Click="SelectAllClick"/><Button Content="Désélectionner" Click="ClearClick"/></StackPanel><TextBlock x:Name="Counter" Grid.Column="1" VerticalAlignment="Center"/></Grid>
        <DataGrid x:Name="NoteList" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" RowHeight="60" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEEEE" Background="White" BorderBrush="#DDDDDD" SelectionMode="Extended" SelectionUnit="FullRow" IsReadOnly="True" SelectionChanged="ListSelectionChanged" PreviewKeyDown="ListKeyDown">
            <DataGrid.RowStyle><Style TargetType="DataGridRow"><EventSetter Event="MouseDoubleClick" Handler="OpenRowDoubleClick"/></Style></DataGrid.RowStyle>
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="24"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Width="12" Height="30" CornerRadius="4" Background="{Binding Color}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Note" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="6" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Excerpt}" Foreground="#777777" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn x:Name="VisibilityColumn" Header="État" Width="90"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Button Click="ToggleRowClick" PreviewMouseLeftButtonDown="ToggleRowMouseDown" Padding="8,7" ToolTip="{Binding State}" AutomationProperties.Name="{Binding ToggleLabel}">
                            <Viewbox Width="20" Height="20"><Canvas Width="24" Height="24">
                                <Path Data="M2,12 C7,4 17,4 22,12 C17,20 7,20 2,12 M15,12 A3,3 0 1 1 9,12 A3,3 0 1 1 15,12" Stroke="#454545" StrokeThickness="1.6" StrokeLineJoin="Round"/>
                                <Path Data="M3,3 L21,21" Stroke="#454545" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                    <Path.Style><Style TargetType="Path"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Hidden}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Path.Style>
                                </Path>
                            </Canvas></Viewbox>
                        </Button>
                        <TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" ToolTip="Épinglée au premier plan">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Pinned}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="4" Margin="0,14,0,0"><TextBlock x:Name="SelectionInfo" Foreground="#666666" Margin="0,0,0,8"/><WrapPanel x:Name="Actions"><Button Content="Afficher la sélection" Click="ShowClick"/><Button Content="Masquer la sélection" Click="HideClick"/><Button Content="Réorganiser en cascade" Click="CascadeClick" ToolTip="Affiche et replace les notes sélectionnées"/><Button Content="Mettre à la corbeille" Click="DeleteClick" Foreground="#A12D2D"/></WrapPanel><WrapPanel x:Name="TrashActions" Visibility="Collapsed"><Button x:Name="RestoreButton" Content="Restaurer la sélection" Click="RestoreClick"/><Button x:Name="PermanentDeleteButton" Content="Supprimer définitivement…" Click="PermanentDeleteClick" Foreground="#A12D2D"/><Button x:Name="EmptyTrashButton" Content="Vider la corbeille…" Click="EmptyTrashClick" Foreground="#A12D2D"/></WrapPanel><StackPanel x:Name="PurgeSettings" Visibility="Collapsed" Margin="0,10,0,0">
            <WrapPanel><CheckBox x:Name="AutoPurge" Content="Purge automatique après" VerticalAlignment="Center"/><TextBox x:Name="PurgeDays" Width="60" Margin="8,0" Padding="5" MaxLength="5" AutomationProperties.Name="Délai de purge en jours"/><TextBlock Text="jours" VerticalAlignment="Center"/><Button Content="Appliquer" Click="ApplyPurgeClick" Margin="8,0"/></WrapPanel>
            <TextBlock Text="Suppression définitive sans confirmation des notes arrivées à échéance, y compris dès l’activation." TextWrapping="Wrap" Foreground="#666666" Margin="0,5,0,0"/>
            <TextBlock x:Name="PurgeStatus" TextWrapping="Wrap" Foreground="#666666"/>
        </StackPanel></StackPanel>
    </Grid></Border>
</Window>
