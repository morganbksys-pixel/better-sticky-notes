<Window x:Class="BetterStickyNotes.NotesWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:BetterStickyNotes" Title="Mes notes — Better Sticky Notes" ShowInTaskbar="True" Icon="Assets/BetterStickyNotes.ico" Width="980" Height="660" MinWidth="740" MinHeight="480" WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13" Foreground="#242629" Background="White">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="2"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E5E7EB"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="#34383F"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.75"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#245BC4"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12,10"/></Style>
        <Style TargetType="DataGridCell"><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#242629"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#245BC4"/><Setter Property="BorderThickness" Value="1"/></Trigger></Style.Triggers></Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#F6F6F5" BorderBrush="#E9E9E7" BorderThickness="0,0,1,0">
            <Grid Margin="12,24,12,16">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Button x:Name="AllNotesButton" Style="{StaticResource NavigationButton}" Click="AllNotesClick"><DockPanel><TextBlock x:Name="AllCount" DockPanel.Dock="Right" Foreground="#73777E"/><TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Toutes les notes"/></DockPanel></Button>
                <Button x:Name="UngroupedButton" Grid.Row="1" Style="{StaticResource NavigationButton}" Click="UngroupedClick"><DockPanel><TextBlock x:Name="UngroupedCount" DockPanel.Dock="Right" Foreground="#73777E"/><TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Sans groupe"/></DockPanel></Button>
                <Grid Grid.Row="2" Margin="12,22,4,8"><TextBlock Text="MES GROUPES" Foreground="#73777E" FontSize="11" VerticalAlignment="Center"/><Button HorizontalAlignment="Right" Padding="6" BorderThickness="0" Background="Transparent" Click="CreateGroupClick" ToolTip="Créer un groupe" AutomationProperties.Name="Créer un groupe"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"/></Button></Grid>
                <ListBox x:Name="GroupList" Grid.Row="3" SelectedValuePath="Key" SelectionChanged="GroupChanged" PreviewMouseDown="GroupsMouseDown" ContextMenuOpening="GroupsContextOpening" AutomationProperties.Name="Groupes de notes" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12,10"/><Setter Property="Margin" Value="0,2"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Surface" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#EBEEF2"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="#EAF1FF"/><Setter Property="Foreground" Value="#245BC4"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#245BC4"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate><Grid ToolTip="{Binding Name}"><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{Binding Color}" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock.LayoutTransform><RotateTransform Angle="-90"/></TextBlock.LayoutTransform></TextBlock><TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding Count}" Foreground="#73777E" Margin="8,0,0,0"/></Grid></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <Border Grid.Row="4" BorderBrush="#E3E4E5" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,16,0,0"><StackPanel><Button x:Name="TrashButton" Style="{StaticResource NavigationButton}" Click="TrashClick"><DockPanel><TextBlock x:Name="TrashCount" DockPanel.Dock="Right" Foreground="#73777E"/><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Corbeille"/></DockPanel></Button><Button x:Name="SettingsButton" Style="{StaticResource NavigationButton}" Click="SettingsClick" AutomationProperties.Name="Paramètres"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBlock Text="Paramètres"/></StackPanel></Button></StackPanel></Border>
            </Grid>
        </Border>
        <Grid x:Name="NotesContent" Grid.Column="1" Margin="28,28,28,18">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="ViewTitle" Text="Toutes les notes" FontSize="26" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0"><Button x:Name="NewNoteButton" Click="NewClick" Height="36" Padding="12,6" Background="#FFF1A8" Foreground="#302D23" BorderThickness="0" ToolTip="Nouvelle note" AutomationProperties.Name="Nouvelle note"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Nouvelle note"/></StackPanel></Button><Button x:Name="EmptyTrashButton" Click="EmptyTrashClick" Height="36" Padding="12,6" Visibility="Collapsed" ToolTip="Vider toute la corbeille" AutomationProperties.Name="Vider la corbeille"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Vider la corbeille…"/></StackPanel></Button></StackPanel>
                <TextBlock x:Name="Counter" Grid.Row="1" Grid.ColumnSpan="2" Foreground="#73777E" FontSize="12" Margin="0,8,0,0"/>
            </Grid>
            <Border Grid.Row="1" BorderBrush="#E3E5E8" BorderThickness="1" CornerRadius="7" Margin="0,24,0,18" Padding="12,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Foreground="#73777E" VerticalAlignment="Center"/>
                <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent" TextChanged="SearchChanged" AutomationProperties.Name="Rechercher dans les notes"/>
                <TextBlock x:Name="SearchPlaceholder" Grid.Column="1" Text="Rechercher dans les notes…" IsHitTestVisible="False" Foreground="#73777E"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
            </Grid></Border>
            <Grid Grid.Row="2">
                <DataGrid x:Name="NoteList" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserResizeColumns="False" HeadersVisibility="None" RowHeight="70" GridLinesVisibility="None" Background="White" BorderThickness="0" SelectionMode="Extended" SelectionUnit="FullRow" IsReadOnly="True" ContextMenuOpening="NotesContextOpening" PreviewMouseDown="NotesRightClick" SelectionChanged="ListSelectionChanged" PreviewKeyDown="ListKeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Margin" Value="0,1"/><EventSetter Event="MouseDoubleClick" Handler="OpenRowDoubleClick"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F5F7FA"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#EAF1FF"/></Trigger></Style.Triggers></Style></DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="24"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Width="4" Height="34" CornerRadius="2" Background="{Binding Color}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="6,0" VerticalAlignment="Center"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding ProtectionMarker}" FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center" Margin="6,0,0,0" ToolTip="{Binding ProtectionState}" AutomationProperties.Name="{Binding ProtectionState}"/><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/></DockPanel><TextBlock Text="{Binding Detail}" Foreground="#73777E" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" FontSize="12"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTemplateColumn x:Name="VisibilityColumn" Width="76"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="&#xE718;" FontFamily="Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Foreground="#73777E" ToolTip="Épinglée au premier plan"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Pinned}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                            <Button Click="ToggleRowClick" PreviewMouseLeftButtonDown="ToggleRowMouseDown" Padding="9,8" Background="Transparent" BorderThickness="0" ToolTip="{Binding State}" AutomationProperties.Name="{Binding ToggleLabel}"><TextBlock Text="{Binding VisibilityGlyph}" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="#73777E"/></Button>
                        </StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20" Visibility="Collapsed"><TextBlock x:Name="EmptyMessage" TextWrapping="Wrap" TextAlignment="Center" Foreground="#73777E"/><Button x:Name="EmptyAction" Content="Créer une note" Click="EmptyActionClick" HorizontalAlignment="Center" Margin="0,14,0,0"/></StackPanel>
            </Grid>
            <TextBlock x:Name="SelectionInfo" Grid.Row="3" Foreground="#73777E" FontSize="12" Margin="0,12,0,0"/>
            <TextBlock Grid.Row="4" Text="Clic droit : actions · Ctrl + clic : sélection multiple" Foreground="#73777E" FontSize="12" Margin="0,18,0,0" TextWrapping="Wrap" ToolTip="Maj+clic : sélectionner une plage · Ctrl+A : tout sélectionner · Suppr : supprimer la sélection · Double-clic : retrouver la note"/>
        </Grid>
        <Border x:Name="SettingsHost" Grid.Column="1" Visibility="Collapsed" Background="White"/>
    </Grid>
</Window>
