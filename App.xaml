<Application x:Class="BetterStickyNotes.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries><ResourceDictionary Source="MenuStyles.xaml"/><ResourceDictionary Source="AppearanceStyles.xaml"/></ResourceDictionary.MergedDictionaries>
    <Style TargetType="Button" BasedOn="{StaticResource AppButtonStyle}"/>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource QuietScrollBar}"/>
    </ResourceDictionary>
  </Application.Resources>
</Application>
