<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppTextBrush" Color="#34383F"/>
    <SolidColorBrush x:Key="AppMutedTextBrush" Color="#646970"/>
    <SolidColorBrush x:Key="AppBorderBrush" Color="#E3E5E8"/>
    <SolidColorBrush x:Key="AppFocusBrush" Color="#245BC4"/>
    <SolidColorBrush x:Key="AppNoteYellowBrush" Color="#FFF1A8"/>
    <SolidColorBrush x:Key="AppNoteInkBrush" Color="#302D23"/>
    <SolidColorBrush x:Key="AppDangerBrush" Color="#B42318"/>
    <SolidColorBrush x:Key="AppSurfaceBrush" Color="White"/>
    <SolidColorBrush x:Key="AppSubtleSurfaceBrush" Color="#F6F6F5"/>
    <SolidColorBrush x:Key="AppSelectionBrush" Color="#EAF1FF"/>
    <SolidColorBrush x:Key="AppFieldBorderBrush" Color="#D9DDE3"/>
    <SolidColorBrush x:Key="AppWindowBorderBrush" Color="#D2D4D7"/>
    <Style x:Key="PageHeadingStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26"/><Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
    </Style>
    <Style x:Key="AppDescriptionStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/><Setter Property="LineHeight" Value="19"/>
    </Style>
    <Style x:Key="SearchFrameStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource AppFieldBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="7"/>
        <Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{StaticResource AppFocusBrush}"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="AppButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="2"/>
        <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
            <Grid x:Name="ButtonRoot" SnapsToDevicePixels="True">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"/>
                <Border x:Name="Interaction" Background="#10000000" CornerRadius="6" Opacity="0" IsHitTestVisible="False"/>
                <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
                <Border x:Name="FocusRing" BorderBrush="{StaticResource AppFocusBrush}" BorderThickness="2" CornerRadius="6" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Interaction" Property="Opacity" Value="1"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Interaction" Property="Background" Value="#20000000"/><Setter TargetName="Interaction" Property="Opacity" Value="1"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonRoot" Property="Opacity" Value="0.45"/><Setter TargetName="Interaction" Property="Opacity" Value="0"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
        <Setter Property="Background" Value="{StaticResource AppNoteYellowBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource AppNoteInkBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="QuietButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="NoteButtonStyle" TargetType="Button" BasedOn="{StaticResource QuietButtonStyle}">
        <Setter Property="Foreground" Value="{StaticResource AppNoteInkBrush}"/>
        <Setter Property="Padding" Value="0"/>
    </Style>
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
        <Setter Property="Background" Value="{StaticResource AppDangerBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="DangerOutlineButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
        <Setter Property="Foreground" Value="{StaticResource AppDangerBrush}"/>
    </Style>
    <Style x:Key="DialogBodyStyle" TargetType="StackPanel">
        <Setter Property="Margin" Value="24"/>
    </Style>
    <Style x:Key="DialogHeadingStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20"/><Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/><Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="DialogDescriptionStyle" TargetType="TextBlock" BasedOn="{StaticResource AppDescriptionStyle}"/>
    <Style x:Key="DialogErrorStyle" TargetType="TextBlock" BasedOn="{StaticResource DialogDescriptionStyle}">
        <Setter Property="Foreground" Value="{StaticResource AppDangerBrush}"/><Setter Property="Margin" Value="0,8,0,0"/>
        <Setter Property="AutomationProperties.LiveSetting" Value="Polite"/>
    </Style>
    <Style x:Key="DialogActionsStyle" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal"/><Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="Margin" Value="0,24,0,0"/>
    </Style>
    <Style x:Key="DialogButtonStyle" TargetType="Button" BasedOn="{StaticResource AppButtonStyle}">
        <Setter Property="MinWidth" Value="88"/><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="8,0,0,0"/>
    </Style>
    <Style x:Key="DialogPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
        <Setter Property="Background" Value="{StaticResource AppNoteYellowBrush}"/><Setter Property="Foreground" Value="{StaticResource AppNoteInkBrush}"/><Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="DialogDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
        <Setter Property="Background" Value="{StaticResource AppDangerBrush}"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style x:Key="CaptureGalleryFilterStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="12,8"/><Setter Property="FontSize" Value="12"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
            <Border x:Name="Choice" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Choice" Property="Background" Value="#EBEEF2"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Choice" Property="Background" Value="{StaticResource AppSelectionBrush}"/><Setter Property="Foreground" Value="{StaticResource AppFocusBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="{StaticResource AppFocusBrush}"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="{StaticResource AppFocusBrush}"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="CaptureGalleryCardStyle" TargetType="ListBoxItem">
        <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}"/><Setter Property="BorderBrush" Value="{StaticResource AppBorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
            <Grid>
                <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
                <Border x:Name="SelectedMark" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Background="{StaticResource AppFocusBrush}" CornerRadius="11" Visibility="Collapsed" IsHitTestVisible="False"><Path Data="M 1,5 L 4,8 L 10,2" Stroke="White" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <Border x:Name="CardFocus" BorderBrush="{StaticResource AppFocusBrush}" BorderThickness="2" CornerRadius="8" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{StaticResource AppSubtleSurfaceBrush}"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="{StaticResource AppSelectionBrush}"/><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AppFocusBrush}"/><Setter TargetName="SelectedMark" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="CardFocus" Property="Visibility" Value="Visible"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="BorderBrush" Value="{StaticResource AppFieldBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="{StaticResource AppSurfaceBrush}"/><Setter Property="Padding" Value="8"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AppFocusBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="PasswordBox">
        <Setter Property="BorderBrush" Value="{StaticResource AppFieldBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="{StaticResource AppSurfaceBrush}"/><Setter Property="Padding" Value="8"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="PasswordBox"><Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource AppFocusBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ToolTip">
        <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="{StaticResource AppSurfaceBrush}"/><Setter Property="Foreground" Value="{StaticResource AppTextBrush}"/><Setter Property="Padding" Value="12,8"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip"><Border Background="{TemplateBinding Background}" BorderBrush="{StaticResource AppBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="QuietThumb" TargetType="Thumb">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Grid Background="Transparent"><Border x:Name="Handle" Width="4" HorizontalAlignment="Center" CornerRadius="2" Background="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Opacity="0.75" Margin="0,2"/></Grid><ControlTemplate.Triggers><DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType=ScrollBar}}" Value="Horizontal"><Setter TargetName="Handle" Property="Width" Value="Auto"/><Setter TargetName="Handle" Property="Height" Value="4"/><Setter TargetName="Handle" Property="HorizontalAlignment" Value="Stretch"/><Setter TargetName="Handle" Property="VerticalAlignment" Value="Center"/><Setter TargetName="Handle" Property="Margin" Value="2,0"/></DataTrigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Handle" Property="Opacity" Value="0.95"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Handle" Property="Opacity" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="QuietPage" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="QuietScrollBar" TargetType="ScrollBar">
        <Setter Property="Width" Value="12"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource AppMutedTextBrush}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}"><Track.DecreaseRepeatButton><RepeatButton x:Name="Before" Style="{StaticResource QuietPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb x:Name="Grip" Style="{StaticResource QuietThumb}" MinHeight="24"/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton x:Name="After" Style="{StaticResource QuietPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton></Track></Grid><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="Grip" Property="MinHeight" Value="0"/><Setter TargetName="Grip" Property="MinWidth" Value="24"/><Setter TargetName="Before" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="After" Property="Command" Value="ScrollBar.PageRightCommand"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="12"/></Trigger></Style.Triggers>
    </Style>
</ResourceDictionary>
