<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="#202020"/>
        <Setter Property="Background" Value="#FAFAFA"/>
        <Setter Property="BorderBrush" Value="#22000000"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="5" Margin="8">
                <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.16"/></Border.Effect>
                <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="600"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></ScrollViewer>
            </Border>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="#202020"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="9,8"/>
        <Setter Property="MinWidth" Value="210"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem">
            <Grid>
                <Border x:Name="Row" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}" Margin="0,1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="16"/></Grid.ColumnDefinitions>
                        <ContentPresenter x:Name="Icon" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="12" Visibility="Collapsed" VerticalAlignment="Center"/>
                        <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="False" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="#777777" FontSize="11" Margin="20,0,0,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="Arrow" Grid.Column="3" Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </Grid>
                </Border>
                <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-3" VerticalOffset="-8" AllowsTransparency="True" Focusable="False" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" PopupAnimation="Fade">
                    <Border Background="#FAFAFA" BorderBrush="#22000000" BorderThickness="1" CornerRadius="9" Padding="5" Margin="8">
                        <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.16"/></Border.Effect>
                        <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="600"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"/></ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#0C000000"/></Trigger>
                <Trigger Property="IsSubmenuOpen" Value="True"><Setter TargetName="Row" Property="Background" Value="#0C000000"/></Trigger>
                <Trigger Property="HasItems" Value="True"><Setter TargetName="Arrow" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/><Setter TargetName="Icon" Property="Visibility" Value="Hidden"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Row" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Separator">
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Separator"><Border Height="1" Background="#16000000" Margin="8,5"/></ControlTemplate></Setter.Value></Setter>
    </Style>
</ResourceDictionary>
