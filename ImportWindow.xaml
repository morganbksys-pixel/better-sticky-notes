<Window x:Class="BetterStickyNotes.ImportWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Importer depuis Sticky Notes" Width="680" Height="500" MinWidth="520" MinHeight="360" WindowStartupLocation="CenterScreen" Background="#FAFAFA" FontFamily="Segoe UI" FontSize="13">
    <Border Background="#FAFAFA" Padding="24"><Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><TextBlock Text="Retrouvez vos notes Windows" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="Summary" Margin="0,8,0,12" TextWrapping="Wrap"/></StackPanel>
        <TextBlock Grid.Row="1" Text="Sélectionnez les notes à importer. Les originales resteront intactes." Margin="0,0,0,10" TextWrapping="Wrap"/>
        <DataGrid x:Name="NoteList" Grid.Row="2" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#EEEEEE" BorderBrush="#DDDDDD" Background="White" RowHeight="40" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTemplateColumn Width="45"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Importer cette note"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="Titre" Binding="{Binding Note.Title}" Width="220" IsReadOnly="True"/>
                <DataGridTextColumn Header="Contenu" Binding="{Binding Note.Text}" Width="*" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>
        <TextBlock Grid.Row="3" Margin="0,12,0,12" Foreground="#666666" TextWrapping="Wrap" Text="Import du texte, des listes et des couleurs. Les images et la mise en forme enrichie ne sont pas importées. Les notes importées seront disponibles dans « Mes notes »."/>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Annuler" IsCancel="True" Padding="18,9"/><Button x:Name="ImportButton" Content="Importer la sélection" Click="ImportClick" Padding="18,9" Background="#E1EAF7"/></StackPanel>
    </Grid></Border>
</Window>
